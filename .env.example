# Copy to .env for local testing (npm start / npm run dev). Do not commit .env.

SMTP_USER=you@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=Underwritly <you@gmail.com>
NOTIFY_EMAIL=info@underwritly.com

# Required for the private profile link in the early-access confirmation email (HMAC).
# Must match Vercel env. Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROFILE_ACCESS_SECRET=

# Public HTTPS origin for links in emails (required for production quality). Use your real domain,
# e.g. https://www.underwritly.com — NOT the *.vercel.app URL (those can show "Sign in to Vercel"
# when Deployment Protection is on). Optional aliases: PUBLIC_SITE_URL or EMAIL_SITE_URL.
# If unset, the API uses the request Host when possible; otherwise falls back to VERCEL_URL.
# Local example: http://localhost:3456
SITE_URL=
# Optional: force the public landing URL used in IFTA launch links (landingApiOrigin). Overrides guess from Host.
# LANDING_PUBLIC_URL=https://www.underwritly.com
# Optional: force insured verify/upload links only (overrides SITE_URL for those emails).
# INSURED_PUBLIC_SITE_URL=https://www.underwritly.com

# Optional: seconds until profile link expires (default 2592000 = 30 days).
# PROFILE_ACCESS_TTL_SECONDS=

# Optional: separate secret for "complete registration" email links (defaults to PROFILE_ACCESS_SECRET).
# COMPLETION_SECRET=

# Optional: seconds until complete-registration link expires (default 604800 = 7 days).
# COMPLETION_TOKEN_TTL_SECONDS=

# Signs session cookies after login / completing registration. Recommended in production (long random string).
# If unset, PROFILE_ACCESS_SECRET is used (fine for local dev).
# SESSION_SECRET=

# PostgreSQL (Neon) — required on Vercel for form submissions + user accounts.
# Neon console → Connection details → copy URI, then:
#   - Local: paste below as DATABASE_URL=... (no quotes). Test with: npm run db:verify
#   - Vercel: Project → Settings → Environment Variables → DATABASE_URL → same value → Redeploy
# Local dev: leave unset to use .data/submissions.sqlite + .data/users.json (see .gitignore).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
# To force local JSON user store when DATABASE_URL exists in your shell:
# USER_STORE=file

# Local HTTPS off: set to 1 only if you need cookies without Secure on a tunneled HTTPS URL during dev.
# FORCE_INSECURE_COOKIE=

# --- Admin back office (/admin.html) — set on Vercel too (strong password in production) ---
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-this-password
# External IFTA app URL (required for production). Use your IFTA Summary Vercel deployment:
# Vercel → IFTA project → Domains → copy https://….vercel.app and add /reports
# Example: https://your-team-ifta.vercel.app/reports
IFTA_DEPLOYMENT_URL=
# Optional: separate HMAC secret for IFTA launch tokens (defaults to SESSION_SECRET / PROFILE_ACCESS_SECRET).
# Must match the value configured on the IFTA Vercel project for token verification.
# IFTA_SHARED_SECRET=
# Optional: launch token lifetime in seconds (60–3600, default 300).
# IFTA_LAUNCH_TTL_SECONDS=
# Insured file push: POST URL is derived from IFTA_DEPLOYMENT_URL → {origin}/api/ingest/underwritly-insured
# (override only if you need a different host: IFTA_INGEST_WEBHOOK_URL=…)
# Optional shared ingest auth — same value on the IFTA Vercel project (npm run vercel:env generates one for both).
# IFTA_INGEST_SECRET=
# Optional: signed tokens for insured verify/upload links (defaults to PROFILE_ACCESS_SECRET).
# INSURED_TOKEN_SECRET=
# Optional: MFA code hashing (defaults to PROFILE_ACCESS_SECRET).
# INSURED_MFA_SECRET=
# Optional: separate secret for admin cookie (defaults to SESSION_SECRET or PROFILE_ACCESS_SECRET).
# ADMIN_SESSION_SECRET=
