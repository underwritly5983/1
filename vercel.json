{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/early-access.js": {
      "maxDuration": 10
    },
    "api/profile-registration.js": {
      "maxDuration": 10
    },
    "api/verify.js": {
      "maxDuration": 10
    },
    "api/complete-registration.js": {
      "maxDuration": 10
    },
    "api/session.js": {
      "maxDuration": 60
    },
    "api/login.js": {
      "maxDuration": 10
    },
    "api/logout.js": {
      "maxDuration": 10
    },
    "api/admin-login.js": {
      "maxDuration": 10
    },
    "api/admin-logout.js": {
      "maxDuration": 10
    },
    "api/admin-session.js": {
      "maxDuration": 10
    },
    "api/admin-submissions.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
